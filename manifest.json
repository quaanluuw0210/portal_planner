{
    "manifest_version": 3,
    "name": "HCMUS Schedule Auto Planner",
    "version": "1.0",
    "action": {
        "default_title": "Mở HCMUS Schedule Planner"
    },
    "background": {
        "service_worker": "src/background/background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "src/content.js"
            ],
            "all_frames": true,
            "run_at": "document_idle"
        }
    ],
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "src/core/parser.js",
                "src/core/scheduler.js",
                "src/core/storage.js",
                "src/ui/overlay.js",
                "assets/styles/injected.css"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}